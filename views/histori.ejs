<%- include('partials/mainHeader') %>

<!-- Navigasi Tab -->
<div data-reveal class="grid grid-cols-4 gap-2 mb-6">
    <a href="/akun_tabungan" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">Akun</a>
    <a href="/kategori?tab=pengeluaran" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">Kategori</a>
    <a href="#" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">Analisis</a>
    <a href="/histori" class="bg-white/80 text-center text-[10px] font-bold text-gray-900 py-2.5 px-1 rounded-xl shadow-xs border border-blue-300 transition-all">History</a>
</div>

<!-- Filter Waktu -->
<div data-reveal data-reveal-delay="60" class="flex justify-end gap-2 mb-4">
    <a href="/histori?filter=all"
       class="<%= filterAktif === 'all' ? 'bg-[#1e3a8a] text-white border-blue-800' : 'bg-white/80 hover:bg-white text-gray-800 border-white/40' %> text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-1 shadow-sm transition-all border">
        All Time
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
    </a>

    <form action="/histori" method="GET" class="flex items-center gap-2">
        <input type="hidden" name="filter" value="bulan">
        <select name="bulan"
            class="<%= filterAktif === 'bulan' ? 'bg-[#1e3a8a] text-white border-blue-800' : 'bg-white/80 hover:bg-white text-gray-800 border-white/40' %> text-xs font-semibold px-3 py-1.5 rounded-full shadow-sm transition-all border focus:outline-none focus:ring-2 focus:ring-blue-500">
            <% listBulan.forEach(function(b) { %>
                <option value="<%= b %>" <%= bulanAktif === b ? 'selected' : '' %>>
                    <%= new Date(b + '-01').toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }) %>
                </option>
            <% }); %>
        </select>
        <button type="submit"
            class="<%= filterAktif === 'bulan' ? 'bg-[#1e3a8a] text-white border-blue-800' : 'bg-white/80 hover:bg-white text-gray-800 border-white/40' %> text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-1 shadow-sm transition-all border">
            Bulan
        </button>
    </form>
</div>

<!-- Panel Form Edit Histori -->
<% if (editHistori) { %>
    <div data-reveal="scale" class="bg-white/60 backdrop-blur-md rounded-2xl p-6 shadow-md border border-white/40 mb-6 text-slate-800">
        <h3 class="text-sm font-bold text-slate-800 mb-4">Edit Histori Data</h3>
        <form action="/histori/update/<%= editHistori.id_histori %>?filter=<%= filterAktif %>&bulan=<%= bulanAktif %>" method="POST" class="space-y-3">
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">Akun Sumber</label>
                <select name="input_nama_akun_baru" required class="w-full bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-xs font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <% akunTabungan.forEach(function(p) { %>
                        <option value="<%= p.nama_akun %>" <%= editHistori.id_akun_src == p.id_akun ? 'selected' : '' %>><%= p.nama_akun %></option>
                    <% }); %>
                </select>
            </div>
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">Kategori</label>
                <select name="input_kategori_baru" required class="w-full bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-xs font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <% kategori.forEach(function(p) { %>
                        <option value="<%= p.nama_kategori %>" <%= editHistori.id_kategori == p.id_kategori ? 'selected' : '' %>><%= p.nama_kategori %></option>
                    <% }); %>
                </select>
            </div>
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">Sub Kategori</label>
                <input type="text" name="input_sub_kategori_baru" value="<%= editHistori.sub_kategori %>" class="w-full bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-xs font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">Nominal Perubahan</label>
                <input type="number" name="input_perubahan_baru" value="<%= editHistori.perubahan %>" required class="w-full bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-xs font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">Tanggal</label>
                <input type="date" name="input_tanggal_baru" value="<%= editHistori.tanggal %>" required class="w-full bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-xs font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="flex gap-2 pt-2">
                <a href="/histori?filter=<%= filterAktif %>&bulan=<%= bulanAktif %>" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 text-xs font-bold py-2 rounded-lg text-center transition-all">Batal</a>
                <button type="submit" class="flex-1 bg-[#1e3a8a] hover:bg-blue-800 text-white text-xs font-bold py-2 rounded-lg text-center transition-all shadow-md">Simpan</button>
            </div>
        </form>
    </div>
<% } %>

<!-- Daftar Riwayat Transaksi -->
<div class="space-y-4">
    <% dataHistoris.forEach(function(hari) { %>
        <div data-reveal="fade" class="flex justify-between items-end px-1 mt-6 mb-2">
            <div class="text-xs font-bold text-slate-800"><%= hari.tanggalTeks %></div>
            <div class="flex gap-3 text-[10px] font-semibold">
                <span class="text-emerald-600">Masuk : Rp <%= hari.pemasukan %></span>
                <span class="text-red-600">Keluar : Rp <%= hari.pengeluaran %></span>
                <span class="text-slate-800">Net : Rp <%= hari.cashFlow %></span>
            </div>
        </div>

        <% hari.dataSehari.forEach(function(p, idx) { %>
            <div data-reveal data-reveal-delay="<%= idx * 70 %>" class="bg-white/60 backdrop-blur-md rounded-2xl p-6 mb-3 shadow-md border border-white/40 text-slate-800">
                <div class="flex justify-between items-start">
                    <div class="flex-1">
                        <h4 class="font-bold text-slate-800 text-sm"><%= p.nama_kategori %></h4>
                        <div class="flex items-center gap-2 mt-1.5">
                            <span class="bg-gray-200/80 text-gray-600 text-[9px] px-2 py-0.5 rounded-full font-semibold tracking-wide"><%= p.sub_kategori %></span>
                            <span class="text-[9px] text-gray-500 font-medium">
                                <%= new Date(p.tanggal).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                            </span>
                        </div>
                    </div>

                    <div class="text-right ml-2">
                        <h4 class="font-semibold text-slate-800 text-xs"><%= p.nama_akun %></h4>
                        <p class="font-bold text-sm mt-0.5 <%= p.jenis === 'Pemasukan' ? 'text-emerald-500' : 'text-red-500' %>">
                            <%= p.jenis === 'Pemasukan' ? '+' : '-' %>Rp <%= Math.abs(p.perubahan).toLocaleString('id-ID', { minimumFractionDigits: 0 }) %>
                        </p>
                    </div>
                </div>

                <div class="flex gap-2 mt-3 pt-3 border-t border-gray-100/80">
                    <% if (p.jenis === 'Pemasukan' || p.jenis === 'Pengeluaran') { %>
                        <a href="/histori?edit_histori_id=<%= p.id %>&filter=<%= filterAktif %>&bulan=<%= bulanAktif %>" class="flex-1 bg-[#1e3a8a] hover:bg-blue-800 text-white text-[10px] font-bold py-2 rounded-xl text-center transition-all shadow-sm">Edit</a>
                    <% } %>
                    <form action="/histori/hapus/<%= p.id %>?filter=<%= filterAktif %>&bulan=<%= bulanAktif %>" method="POST" class="flex-1" onsubmit="return confirm('Hapus data histori ini secara permanen?')">
                        <button type="submit" class="w-full bg-transparent hover:bg-red-50 text-red-600 border border-red-200 text-[10px] font-bold py-2 rounded-xl text-center transition-all">Hapus</button>
                    </form>
                </div>
            </div>
        <% }); %>
    <% }); %>

    <% if (dataHistoris.length === 0) { %>
        <div data-reveal="fade" class="text-center text-slate-500 text-xs py-10 bg-white/60 backdrop-blur-md rounded-2xl border border-white/40">
            Belum ada riwayat transaksi.
        </div>
    <% } %>
</div>

<%- include('partials/mainFooter') %>