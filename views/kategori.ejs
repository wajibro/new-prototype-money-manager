<%- include('partials/mainHeader') %>

<div data-reveal class="grid grid-cols-4 gap-2 mb-6">
    <a href="/akun_tabungan" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">Akun</a>
    <a href="/kategori?tab=pengeluaran" class="bg-white/80 text-center text-[10px] font-bold text-gray-900 py-2.5 px-1 rounded-xl shadow-xs border border-blue-300 transition-all">Catat</a>
    <a href="/analisis" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">Analisis</a>
    <a href="/histori" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">History</a>
</div>

<%
    const isPengeluaran = tabAktif === 'pengeluaran';
    const jenisAktif = isPengeluaran ? 'Pengeluaran' : 'Pemasukan';
    const prioritasAktif = prioritas.filter(p => p.jenis === jenisAktif);
%>

<div data-reveal data-reveal-delay="80" class="bg-white/60 backdrop-blur-md rounded-3xl p-6 shadow-sm border border-white/20 flex-1 flex flex-col justify-between">

    <!-- Tombol Tab Pemasukan / Pengeluaran -->
    <div class="grid grid-cols-2 gap-3 mb-6">
        <a href="/kategori?tab=pemasukan"
           class="flex items-center justify-center gap-1 text-xs font-semibold py-2 px-3 rounded-xl transition-all shadow-sm <%= !isPengeluaran ? 'bg-[#1c9c4b] text-white shadow-inner pointer-events-none opacity-90' : 'bg-gray-100 hover:bg-gray-200 text-gray-600' %>">
            <span class="text-sm">↓</span> Pemasukan
        </a>
        <a href="/kategori?tab=pengeluaran"
           class="flex items-center justify-center gap-1 text-xs font-semibold py-2 px-3 rounded-xl transition-all shadow-sm <%= isPengeluaran ? 'bg-[#d33232] text-white shadow-inner pointer-events-none opacity-90' : 'bg-gray-100 hover:bg-gray-200 text-gray-600' %>">
            <span class="text-sm">↑</span> Pengeluaran
        </a>
    </div>

    <form action="/kategori/simpan/<%= tabAktif %>" method="POST">
        <h3 class="text-base font-bold text-slate-900 tracking-wide mb-4">Catat <%= tabAktif %> baru</h3>

        <!-- GRID LAYOUT: 2 KOLOM -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
            
            <!-- KIRI 1: Tanggal -->
            <div class="flex flex-col">
                <label class="text-xs font-bold text-slate-900 mb-1.5">Tanggal</label>
                <input type="date" name="input_tanggal" id="input_tanggal" required
                       class="w-full bg-[#c2e2ff] border border-blue-200/50 rounded-xl px-4 py-2.5 text-sm font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <!-- KANAN 1: Akun Tabungan -->
            <div class="flex flex-col">
                <label class="text-xs font-bold text-slate-900 mb-1.5">Akun Tabungan</label>
                <select name="input_akun_tabungan" required
                        class="w-full bg-[#c2e2ff] border border-blue-200/50 rounded-xl px-4 py-2.5 text-sm font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">-- Pilih Rekening Sumber --</option>
                    <% akunTabungan.forEach(function(akun) { %>
                        <option value="<%= akun.id_akun %>"><%= akun.nama_akun %> (Rp <%= akun.total_akun.toLocaleString('id-ID') %>)</option>
                    <% }); %>
                </select>
            </div>

            <!-- KIRI 2: Prioritas -->
            <div class="flex flex-col">
                <label class="text-xs font-bold text-slate-900 mb-1.5">Prioritas</label>
                <select name="input_prioritas" required
                        class="w-full bg-[#c2e2ff] border border-blue-200/50 rounded-xl px-4 py-2.5 text-sm font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">-- Pilih Prioritas --</option>
                    <% prioritasAktif.forEach(function(p) { %>
                        <option value="<%= p.id_prioritas %>"><%= p.nama_prioritas %></option>
                    <% }); %>
                </select>
                <% if (prioritasAktif.length === 0) { %>
                    <span class="text-[10px] text-slate-500 mt-1"><a href="/pengaturan?tab=prioritas" class="text-blue-700 font-semibold hover:underline">Tambah prioritas dulu</a></span>
                <% } %>
            </div>

            <!-- KANAN 2: Kategori -->
            <div class="flex flex-col">
                <label class="text-xs font-bold text-slate-900 mb-1.5">Kategori</label>
                <select name="input_kategori" required
                        class="w-full bg-[#c2e2ff] border border-blue-200/50 rounded-xl px-4 py-2.5 text-sm font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">-- Pilih Kategori --</option>
                    <% kategori.forEach(function(k) { %>
                        <option value="<%= k.id_kategori %>"><%= k.nama_kategori %></option>
                    <% }); %>
                </select>
                <% if (kategori.length === 0) { %>
                    <span class="text-[10px] text-slate-500 mt-1"><a href="/pengaturan?tab=kategori" class="text-blue-700 font-semibold hover:underline">Tambah kategori dulu</a></span>
                <% } %>
            </div>

            <!-- BARIS 3: Nominal (Colspan 2) -->
            <div class="flex flex-col sm:col-span-2">
                <label class="text-xs font-bold text-slate-900 mb-1.5">Nominal (Rp)</label>
                <input type="text" id="currency_input" placeholder="0" required inputmode="numeric"
                       class="w-full bg-[#c2e2ff] border border-blue-200/50 rounded-xl pl-4 pr-4 py-2.5 text-sm font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
                <input type="hidden" name="input_total_perubahan" id="clean_nominal">
                
                <!-- Tombol Shortcut -->
                <div class="flex gap-2 mt-2">
                    <button type="button" class="btn-shortcut bg-blue-100 hover:bg-blue-200 text-blue-800 text-xs font-bold py-1.5 px-4 rounded-lg transition-colors border border-blue-200/50" data-val="00">+ 00</button>
                    <button type="button" class="btn-shortcut bg-blue-100 hover:bg-blue-200 text-blue-800 text-xs font-bold py-1.5 px-4 rounded-lg transition-colors border border-blue-200/50" data-val="000">+ 000</button>
                </div>
            </div>

            <!-- BARIS 4: Note (Colspan 2) -->
            <div class="flex flex-col sm:col-span-2">
                <label class="text-xs font-bold text-slate-900 mb-1.5">Note <span class="text-slate-400 font-normal">(opsional)</span></label>
                <input type="text" name="input_note" maxlength="255" placeholder="Catatan khusus transaksi ini"
                       class="w-full bg-[#c2e2ff] border border-blue-200/50 rounded-xl px-4 py-2.5 text-sm font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

        </div>

        <!-- Tombol Simpan -->
        <div class="flex justify-center pt-2">
            <button type="submit" class="w-full sm:w-44 bg-[#387df6] hover:bg-blue-600 text-white font-bold text-sm py-2.5 px-6 rounded-xl shadow-md transition-all tracking-wider uppercase">Simpan</button>
        </div>
    </form>

    <div class="flex justify-center gap-2 mt-8 border-t border-gray-200/50 pt-6">
        <a href="/pengaturan?tab=prioritas" class="bg-[#6fa8e0] hover:bg-blue-500 text-white text-xs font-bold py-2.5 px-5 rounded-full transition-all shadow-sm">+ Kelola Prioritas</a>
        <a href="/pengaturan?tab=kategori" class="bg-[#6fa8e0] hover:bg-blue-500 text-white text-xs font-bold py-2.5 px-5 rounded-full transition-all shadow-sm">+ Kelola Kategori</a>
    </div>
</div>

<script>
    const currencyInput = document.getElementById('currency_input');
    const cleanNominal = document.getElementById('clean_nominal');
    const shortcutBtns = document.querySelectorAll('.btn-shortcut');

    // Limiter & Formatter: Hanya menerima angka (menolak . dan ,), memformat dengan titik ribuan
    currencyInput.addEventListener('input', function () {
        let bersih = this.value.replace(/\D/g, ''); // Hapus semua selain angka
        this.value = bersih ? new Intl.NumberFormat('id-ID').format(bersih) : '';
    });

    // Shortcut +00 dan +000
    shortcutBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            let currentVal = currencyInput.value.replace(/\D/g, '');
            if (!currentVal) currentVal = '0';
            
            currencyInput.value = currentVal + this.getAttribute('data-val');
            currencyInput.dispatchEvent(new Event('input')); // Trigger format ulang
            currencyInput.focus();
        });
    });

    // Saat submit, bersihkan titik format agar yang dikirim murni angka
    document.querySelector('form').addEventListener('submit', function () {
        cleanNominal.value = currencyInput.value.replace(/[^0-9]/g, '');
    });

    // Default tanggal
    const hariIni = new Date();
    document.getElementById('input_tanggal').value =
        `${hariIni.getFullYear()}-${String(hariIni.getMonth() + 1).padStart(2, '0')}-${String(hariIni.getDate()).padStart(2, '0')}`;
</script>

<%- include('partials/mainFooter') %>