<%- include('partials/mainHeader') %>

<!-- Navigasi Tab -->
<div data-reveal class="grid grid-cols-4 gap-2 mb-6">
    <a href="/akun_tabungan" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">Akun</a>
    <a href="/kategori?tab=pengeluaran" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">Kategori</a>
    <a href="/analisis" class="bg-white/80 text-center text-[10px] font-bold text-gray-900 py-2.5 px-1 rounded-xl shadow-xs border border-blue-300 transition-all">Analisis</a>
    <a href="/histori" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">History</a>
</div>

<!-- ═══════════ FILTER WAKTU ═══════════ -->
<div data-reveal data-reveal-delay="40" class="flex justify-end gap-2 mb-4">
    <a href="/analisis?filter=all"
       class="<%= filterAktif === 'all' ? 'bg-[#1e3a8a] text-white border-blue-800' : 'bg-white/80 hover:bg-white text-gray-800 border-white/40' %> text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-1 shadow-sm transition-all border">
        All Time
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
    </a>

    <form action="/analisis" method="GET" class="flex items-center gap-2">
        <input type="hidden" name="filter" value="bulan">
        <select name="bulan"
            class="<%= filterAktif === 'bulan' ? 'bg-[#1e3a8a] text-white border-blue-800' : 'bg-white/80 hover:bg-white text-gray-800 border-white/40' %> text-xs font-semibold px-3 py-1.5 rounded-full shadow-sm transition-all border focus:outline-none focus:ring-2 focus:ring-blue-500">
            <% listBulan.forEach(function(b) { %>
                <option value="<%= b %>" <%= bulanAktif === b ? 'selected' : '' %>>
                    <%= new Date(b + '-01').toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }) %>
                </option>
            <% }); %>
        </select>
        <button type="submit"
            class="<%= filterAktif === 'bulan' ? 'bg-[#1e3a8a] text-white border-blue-800' : 'bg-white/80 hover:bg-white text-gray-800 border-white/40' %> text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-1 shadow-sm transition-all border">
            Bulan
        </button>
    </form>
</div>

<!-- ═══════════ SECTION 1: Donut Analisis Pengeluaran per Bulan ═══════════ -->
<div data-reveal class="bg-white/60 backdrop-blur-md rounded-2xl p-4 shadow-md border border-white/40 mb-6">
    <h2 class="text-sm font-bold text-slate-800 mb-4">Analisis Pengeluaran per Bulan</h2>
    <div id="donutContainer" class="grid grid-cols-1 gap-6"></div>
    <div id="donutEmpty" class="hidden text-center text-xs text-slate-500 py-8">Belum ada data analisis pengeluaran.</div>
</div>

<!-- ═══════════ SECTION 2: Riwayat Saldo Harian ═══════════ -->
<div data-reveal data-reveal-delay="60" class="bg-white/60 backdrop-blur-md rounded-2xl p-4 shadow-md border border-white/40 mb-6">
    <h2 class="text-sm font-bold text-slate-800 mb-3">Riwayat Saldo Harian, Pemasukan & Pengeluaran</h2>
    <div class="relative" style="height: 260px;">
        <canvas id="chartSaldoLine"></canvas>
    </div>
    <div class="relative mt-3" style="height: 140px;">
        <canvas id="chartSaldoBar"></canvas>
    </div>
</div>

<!-- ═══════════ SECTION 3: Saldo Harian per Akun ═══════════ -->
<div data-reveal data-reveal-delay="120" class="bg-white/60 backdrop-blur-md rounded-2xl p-4 shadow-md border border-white/40 mb-6">
    <h2 class="text-sm font-bold text-slate-800 mb-3">Riwayat Saldo Harian per Akun</h2>
    <div id="perAkunContainer" class="space-y-5"></div>
    <div id="perAkunEmpty" class="hidden text-center text-xs text-slate-500 py-8">Belum ada data saldo per akun.</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
// ═══════════════════════════════════════════════════════════
// Fungsi Global untuk Toggle Collapse Sub-Kategori
// ═══════════════════════════════════════════════════════════
window.toggleSubcat = function(subcatId, chevronId) {
    const subcatEl = document.getElementById(subcatId);
    const chevronEl = document.getElementById(chevronId);
    if (subcatEl && chevronEl) {
        subcatEl.classList.toggle('hidden');
        chevronEl.classList.toggle('-rotate-90');
    }
};

// ═══════════════════════════════════════════════════════════
// Data injection
// ═══════════════════════════════════════════════════════════
const analisisData    = <%- analisisDataJson %>;
const saldoHarianData = <%- saldoHarianJson %>;
const saldoPerAkunData= <%- saldoPerAkunJson %>;

// ═══════════════════════════════════════════════════════════
// Helpers
// ═══════════════════════════════════════════════════════════
const BASE_COLORS = ["#4E79A7","#F28E2B","#E15759","#76B7B2","#59A14F","#EDC948","#B07AA1","#FF9DA7"];
const SUB_LIGHTEN = 0.45;
const SUB_MIN_SHADE = 0.15;
const PALETTE = ['#1f77b4','#ff7f0e','#2ca02c','#d62728','#9467bd','#8c564b','#e377c2','#7f7f7f','#bcbd22','#17becf'];
const POINT_STYLES = ['circle','rect','triangle','rectRot','star','cross','crossRot','rectRounded','triangleRot','line'];

function hexToRgb(hex){
    const h = hex.replace('#','');
    return [parseInt(h.slice(0,2),16), parseInt(h.slice(2,4),16), parseInt(h.slice(4,6),16)];
}
function shade(hex, factor){
    let [r,g,b] = hexToRgb(hex);
    if (factor >= 0){
        r = r + (255-r)*factor;
        g = g + (255-g)*factor;
        b = b + (255-b)*factor;
    } else {
        r *= (1+factor); g *= (1+factor); b *= (1+factor);
    }
    return `rgb(${Math.round(r)}, ${Math.round(g)}, ${Math.round(b)})`;
}
function fmtRp(n){
    return 'Rp ' + Number(n||0).toLocaleString('id-ID', { maximumFractionDigits: 0 });
}
function fmtTanggal(str){
    if (!str) return '';
    const d = new Date(str);
    return d.toLocaleDateString('id-ID', { day:'2-digit', month:'short' });
}
function parseMaybeJson(v){
    if (v == null) return {};
    if (typeof v === 'string'){ try { return JSON.parse(v); } catch(e){ return {}; } }
    return v;
}

// TAMBAHAN FUNGSI: Format "2026-10" menjadi "Oktober 2026"
function formatBulanIndo(bulanStr) {
    if (!bulanStr || bulanStr === 'unknown') return bulanStr;
    const dateObj = new Date(`${bulanStr}-01`);
    if (isNaN(dateObj.getTime())) return bulanStr;
    // Menghasilkan format "Oktober 2026"
    return dateObj.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
}

// ═══════════════════════════════════════════════════════════
// SECTION 1 — Donut per Bulan & Grouped Progress Bar (Collapsible)
// ═══════════════════════════════════════════════════════════
(function renderDonuts(){
    const container = document.getElementById('donutContainer');
    const emptyEl = document.getElementById('donutEmpty');

    if (!Array.isArray(analisisData) || analisisData.length === 0){
        emptyEl.classList.remove('hidden');
        return;
    }

    analisisData.forEach((row, idx) => {
        const rawBulan = row.bulan || 'unknown';
        const bulanTeks = formatBulanIndo(rawBulan); // Gunakan format bulan teks
        const kategoriDict = parseMaybeJson(row.kategori_dictionary);
        const subDict      = parseMaybeJson(row.sub_kategori_dictionary);

        const categories = Object.keys(kategoriDict)
            .sort((a,b) => Math.abs(kategoriDict[b].nominal||0) - Math.abs(kategoriDict[a].nominal||0));

        if (categories.length === 0){
            container.innerHTML += `<div class="bg-white/70 rounded-xl p-3 border border-white/40 text-center text-xs text-slate-500 py-8">${bulanTeks}: tidak ada data</div>`;
            return;
        }

        const catColorMap = {};
        categories.forEach((c, i) => catColorMap[c] = BASE_COLORS[i % BASE_COLORS.length]);

        const catValues = categories.map(c => Math.abs(kategoriDict[c].nominal || 0));
        const catPcts   = categories.map(c => kategoriDict[c].persentase || 0);
        const catColors = categories.map(c => catColorMap[c]);
        const totalCat  = catValues.reduce((s,v)=>s+v,0);

        const subLabels = [], subValues = [], subPcts = [], subColors = [];
        categories.forEach(cat => {
            const subs = subDict[cat] || {};
            const entries = Object.entries(subs)
                .sort((a,b) => Math.abs(b[1].nominal||0) - Math.abs(a[1].nominal||0));
            const n = entries.length;
            const base = catColorMap[cat];
            entries.forEach(([subName, info], j) => {
                const factor = n === 1
                    ? SUB_LIGHTEN
                    : SUB_LIGHTEN - (SUB_LIGHTEN - SUB_MIN_SHADE) * (j / (n - 1));
                subLabels.push(subName);
                subValues.push(Math.abs(info.nominal || 0));
                subPcts.push(info.persentase || 0);
                subColors.push(shade(base, factor));
            });
        });

        const wrap = document.createElement('div');
        wrap.className = 'bg-white/80 rounded-2xl p-5 border border-white/50 shadow-sm';
        
        wrap.innerHTML = `
            <div class="text-center md:text-left text-sm font-bold text-slate-800 mb-6">
                ${bulanTeks} &nbsp;—&nbsp; Total: ${fmtRp(totalCat)}
            </div>
            
            <div class="flex flex-col lg:flex-row gap-8 items-center lg:items-start">
                <div class="w-[260px] sm:w-[300px] flex-shrink-0 relative" style="height: 260px;">
                    <canvas id="donut-${idx}"></canvas>
                </div>
                
                <div class="w-full flex-grow">
                    <div id="groupedLegend-${idx}" class="space-y-4"></div>
                </div>
            </div>
        `;
        container.appendChild(wrap);

        new Chart(document.getElementById(`donut-${idx}`), {
            type: 'doughnut',
            data: {
                labels: categories,
                datasets: [
                    {
                        label: 'Prioritas',
                        data: catValues,
                        backgroundColor: catColors,
                        borderColor: '#fff',
                        borderWidth: 2
                    },
                    {
                        label: 'Kategori',
                        data: subValues,
                        backgroundColor: subColors,
                        borderColor: '#fff',
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (ctx) => {
                                const val = ctx.parsed;
                                const total = ctx.dataset.data.reduce((s,v)=>s+v,0);
                                const pct = total > 0 ? (val/total*100).toFixed(2) : '0.00';
                                return `${ctx.label}: ${fmtRp(val)} (${pct}%)`;
                            }
                        }
                    }
                }
            }
        });

        const groupedLegend = document.getElementById(`groupedLegend-${idx}`);
        let legendHTML = '';

        categories.forEach((cat, i) => {
            const catVal = catValues[i];
            const catPct = (typeof catPcts[i] === 'number' ? catPcts[i] : parseFloat(catPcts[i]) || 0).toFixed(2);
            const catColor = catColors[i];

            const subs = subDict[cat] || {};
            const subEntries = Object.entries(subs)
                .sort((a,b) => Math.abs(b[1].nominal||0) - Math.abs(a[1].nominal||0));
            const hasSubs = subEntries.length > 0;

            legendHTML += `
                <div class="w-full ${hasSubs ? 'cursor-pointer group' : ''}" ${hasSubs ? `onclick="toggleSubcat('subcat-${idx}-${i}', 'chevron-${idx}-${i}')"` : ''}>
                    <div class="flex justify-between items-end mb-1.5">
                        <div class="flex items-center gap-1.5">
                            <span class="text-xs font-bold text-slate-800 ${hasSubs ? 'group-hover:text-blue-600 transition-colors' : ''}">${cat}</span>
                            ${hasSubs ? `
                            <svg id="chevron-${idx}-${i}" class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                            ` : ''}
                        </div>
                        <span class="text-[11px] font-semibold text-slate-600">${fmtRp(catVal)} <span class="text-slate-400 font-normal ml-1">(${catPct}%)</span></span>
                    </div>
                    <div class="w-full bg-slate-200/80 rounded-full h-2.5">
                        <div class="h-2.5 rounded-full transition-all duration-300" style="width: ${catPct}%; background-color: ${catColor};"></div>
                    </div>
                </div>
            `;

            if (hasSubs) {
                legendHTML += `<div id="subcat-${idx}-${i}" class="pl-3 mt-2.5 space-y-2.5 border-l-2 border-slate-200 ml-1 hidden">`;
                
                subEntries.forEach(([subName, info], j) => {
                    const subVal = Math.abs(info.nominal || 0);
                    const subPct = (info.persentase || 0).toFixed(2);
                    
                    const n = subEntries.length;
                    const factor = n === 1
                        ? SUB_LIGHTEN
                        : SUB_LIGHTEN - (SUB_LIGHTEN - SUB_MIN_SHADE) * (j / (n - 1));
                    const subColor = shade(catColor, factor);

                    legendHTML += `
                        <div class="w-full">
                            <div class="flex justify-between items-end mb-1">
                                <span class="text-[11px] font-semibold text-slate-600">${subName}</span>
                                <span class="text-[10px] font-medium text-slate-500">${fmtRp(subVal)} <span class="text-slate-400 font-normal ml-1">(${subPct}%)</span></span>
                            </div>
                            <div class="w-full bg-slate-200/60 rounded-full h-1.5">
                                <div class="h-1.5 rounded-full" style="width: ${subPct}%; background-color: ${subColor};"></div>
                            </div>
                        </div>
                    `;
                });
                
                legendHTML += `</div>`;
            }
        });

        groupedLegend.innerHTML = legendHTML;
    });
})();

// ═══════════════════════════════════════════════════════════
// SECTION 2 — Line (saldo) + Bar (pemasukan/pengeluaran)
// ═══════════════════════════════════════════════════════════
(function renderSaldoHarian(){
    if (!Array.isArray(saldoHarianData) || saldoHarianData.length === 0) return;

    const labels = saldoHarianData.map(r => r.tanggal);
    const saldoAkhir = saldoHarianData.map(r => Number(r.total_saldo_akhir_sistem) || 0);
    const pemasukan  = saldoHarianData.map(r => Number(r.pemasukan) || 0);
    const pengeluaran= saldoHarianData.map(r => Number(r.pengeluaran) || 0);

    new Chart(document.getElementById('chartSaldoLine'), {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'Total Saldo Akhir',
                data: saldoAkhir,
                borderColor: '#1f77b4',
                backgroundColor: 'rgba(31,119,180,0.10)',
                fill: true,
                tension: 0.2,
                borderWidth: 2,
                pointRadius: 3,
                pointHoverRadius: 5,
                pointBackgroundColor: '#1f77b4'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'top', labels: { font: { size: 10 }, boxWidth: 12 } },
                title: {
                    display: true,
                    text: 'Riwayat Saldo Harian, Pemasukan & Pengeluaran',
                    font: { size: 12, weight: 'bold' },
                    color: '#0f172a'
                },
                tooltip: {
                    callbacks: { label: (ctx) => `${ctx.dataset.label}: ${fmtRp(ctx.parsed.y)}` }
                }
            },
            scales: {
                x: { display: false },
                y: {
                    ticks: { callback: v => Number(v).toLocaleString('id-ID'), font: { size: 10 } },
                    grid: { color: 'rgba(0,0,0,0.05)' }
                }
            }
        }
    });

    new Chart(document.getElementById('chartSaldoBar'), {
        type: 'bar',
        data: {
            labels,
            datasets: [
                { label: 'Pemasukan',   data: pemasukan,   backgroundColor: '#2ecc71', borderRadius: 3 },
                { label: 'Pengeluaran', data: pengeluaran, backgroundColor: '#e74c3c', borderRadius: 3 }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'top', labels: { font: { size: 10 }, boxWidth: 12 } },
                tooltip: {
                    callbacks: { label: (ctx) => `${ctx.dataset.label}: ${fmtRp(ctx.parsed.y)}` }
                }
            },
            scales: {
                x: {
                    ticks: {
                        callback: function(val) { return fmtTanggal(this.getLabelForValue(val)); },
                        maxRotation: 45, minRotation: 45,
                        autoSkip: true, maxTicksLimit: 15,
                        font: { size: 9 }
                    },
                    grid: { display: false }
                },
                y: {
                    ticks: { callback: v => Number(v).toLocaleString('id-ID'), font: { size: 10 } },
                    grid: { color: 'rgba(0,0,0,0.05)' }
                }
            }
        }
    });
})();

// ═══════════════════════════════════════════════════════════
// SECTION 3 — Saldo per akun, dikelompokkan berdasarkan skala
// ═══════════════════════════════════════════════════════════
(function renderPerAkun(){
    const container = document.getElementById('perAkunContainer');
    const emptyEl = document.getElementById('perAkunEmpty');

    if (!Array.isArray(saldoPerAkunData) || saldoPerAkunData.length === 0){
        emptyEl.classList.remove('hidden');
        return;
    }

    const tanggalList = Array.from(new Set(saldoPerAkunData.map(r => r.tanggal))).sort();

    const byAccount = {};
    saldoPerAkunData.forEach(r => {
        const name = (r.nama_akun || '').trim();
        if (!name) return;
        if (!byAccount[name]) byAccount[name] = {};
        byAccount[name][r.tanggal] = Number(r.total_saldo_akhir) || 0;
    });

    Object.keys(byAccount).forEach(acc => {
        let last = null;
        tanggalList.forEach(t => {
            if (byAccount[acc][t] !== undefined) last = byAccount[acc][t];
            else byAccount[acc][t] = last; 
        });
    });

    const maxAbs = {};
    Object.keys(byAccount).forEach(acc => {
        let m = 0;
        tanggalList.forEach(t => {
            const v = byAccount[acc][t];
            if (v !== null && Math.abs(v) > m) m = Math.abs(v);
        });
        maxAbs[acc] = m;
    });

    const BATAS_BESAR = 1_000_000;
    const BATAS_SEDANG = 100_000;
    const akunBesar = [], akunSedang = [], akunKecil = [];
    Object.keys(byAccount).forEach(acc => {
        if (maxAbs[acc] >= BATAS_BESAR) akunBesar.push(acc);
        else if (maxAbs[acc] >= BATAS_SEDANG) akunSedang.push(acc);
        else akunKecil.push(acc);
    });

    const grup = [
        { judul: 'Saldo Besar (≥ 1 juta)',   akun: akunBesar },
        { judul: 'Saldo Sedang (100rb–1jt)', akun: akunSedang },
        { judul: 'Saldo Kecil (< 100rb)',    akun: akunKecil }
    ].filter(g => g.akun.length > 0);

    grup.forEach((g, gi) => {
        const block = document.createElement('div');
        block.className = 'bg-white/70 rounded-xl p-3 border border-white/40';
        block.innerHTML = `
            <div class="text-xs font-bold text-slate-800 mb-2">${g.judul}</div>
            <div class="relative" style="height: 240px;">
                <canvas id="perAkunChart-${gi}"></canvas>
            </div>
        `;
        container.appendChild(block);

        const datasets = g.akun.map((acc, i) => ({
            label: acc,
            data: tanggalList.map(t => byAccount[acc][t]),
            borderColor: PALETTE[i % PALETTE.length],
            backgroundColor: PALETTE[i % PALETTE.length],
            pointStyle: POINT_STYLES[i % POINT_STYLES.length],
            pointRadius: 4,
            pointHoverRadius: 6,
            borderWidth: 1.8,
            tension: 0.15,
            spanGaps: true
        }));

        new Chart(document.getElementById(`perAkunChart-${gi}`), {
            type: 'line',
            data: { labels: tanggalList, datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: { font: { size: 10 }, boxWidth: 12, boxHeight: 12, usePointStyle: true }
                    },
                    tooltip: {
                        callbacks: { label: (ctx) => `${ctx.dataset.label}: ${fmtRp(ctx.parsed.y)}` }
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            callback: function(val) { return fmtTanggal(this.getLabelForValue(val)); },
                            maxRotation: 45, minRotation: 45,
                            autoSkip: true, maxTicksLimit: 15,
                            font: { size: 9 }
                        },
                        grid: { display: false }
                    },
                    y: {
                        ticks: { callback: v => Number(v).toLocaleString('id-ID'), font: { size: 10 } },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    }
                }
            }
        });
    });
})();
</script>

<%- include('partials/mainFooter') %>