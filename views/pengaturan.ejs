<%- include('partials/mainHeader') %>

<div data-reveal class="grid grid-cols-4 gap-2 mb-6">
    <a href="/akun_tabungan" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">Akun</a>
    <a href="/kategori?tab=pengeluaran" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">Catat</a>
    <a href="/analisis" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">Analisis</a>
    <a href="/histori" class="bg-white/60 hover:bg-white text-center text-[10px] font-medium text-gray-800 py-2.5 px-1 rounded-xl shadow-xs border border-white/30 transition-all">History</a>
</div>

<div data-reveal class="grid grid-cols-2 gap-3 mb-6">
    <a href="/pengaturan?tab=prioritas"
       class="text-center text-xs font-bold py-2.5 rounded-xl shadow-sm transition-all border <%= tabAktif === 'prioritas' ? 'bg-[#1e3a8a] text-white border-blue-800' : 'bg-white/80 hover:bg-white text-gray-800 border-white/40' %>">
        Prioritas
    </a>
    <a href="/pengaturan?tab=kategori"
       class="text-center text-xs font-bold py-2.5 rounded-xl shadow-sm transition-all border <%= tabAktif === 'kategori' ? 'bg-[#1e3a8a] text-white border-blue-800' : 'bg-white/80 hover:bg-white text-gray-800 border-white/40' %>">
        Kategori
    </a>
</div>

<% if (message) { %>
    <div data-reveal="fade" class="bg-red-50 border border-red-200 text-red-700 text-xs font-semibold rounded-xl px-4 py-3 mb-4"><%= message %></div>
<% } %>

<!-- ══════════════ TAB PRIORITAS ══════════════ -->
<% if (tabAktif === 'prioritas') { %>

    <% if (editPrioritas) { %>
    <div data-reveal="scale" class="bg-white/90 rounded-2xl p-5 shadow-sm border border-white/40 mb-5">
        <h3 class="text-sm font-bold text-slate-800 mb-4">Edit Prioritas: <%= editPrioritas.nama_prioritas %></h3>
        <form action="/pengaturan/prioritas/update/<%= editPrioritas.id_prioritas %>" method="POST" class="space-y-3">
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">Nama Prioritas</label>
                <input type="text" name="input_nama_prioritas_baru" value="<%= editPrioritas.nama_prioritas %>" required
                       class="w-full bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-xs font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">Jenis</label>
                <select name="input_jenis_prioritas_baru" required
                        class="w-full bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-xs font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="Pengeluaran" <%= editPrioritas.jenis === 'Pengeluaran' ? 'selected' : '' %>>Pengeluaran</option>
                    <option value="Pemasukan" <%= editPrioritas.jenis === 'Pemasukan' ? 'selected' : '' %>>Pemasukan</option>
                </select>
            </div>
            <div class="flex gap-2 pt-2">
                <a href="/pengaturan?tab=prioritas" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 text-xs font-bold py-2 rounded-lg text-center">Batal</a>
                <button type="submit" class="flex-1 bg-[#1e3a8a] hover:bg-blue-800 text-white text-xs font-bold py-2 rounded-lg shadow-md">Simpan</button>
            </div>
        </form>
    </div>
    <% } %>

    <div data-reveal="scale" class="bg-white/90 rounded-2xl p-5 shadow-sm border border-white/40 mb-5">
        <h3 class="text-sm font-bold text-slate-800 mb-4">Tambah Prioritas Baru</h3>
        <form action="/pengaturan/prioritas/tambah" method="POST" class="space-y-3">
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">Nama Prioritas</label>
                <input type="text" name="input_nama_prioritas_baru" placeholder="Misal: Kebutuhan Pokok, Gaya Hidup" required
                       class="w-full bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-xs font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">Jenis</label>
                <select name="input_jenis_prioritas_baru" required
                        class="w-full bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-xs font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="Pengeluaran">Pengeluaran</option>
                    <option value="Pemasukan">Pemasukan</option>
                </select>
            </div>
            <button type="submit" class="w-full bg-[#1c9c4b] hover:bg-emerald-700 text-white text-xs font-bold py-2 rounded-lg shadow-md">Tambah Prioritas</button>
        </form>
    </div>

    <div class="space-y-2">
        <% prioritas.forEach(function(p) { %>
        <div data-reveal class="bg-white/80 rounded-xl px-4 py-3 shadow-sm border border-white/40 flex items-center justify-between gap-3">
            <div class="min-w-0">
                <div class="text-sm font-bold text-slate-800 truncate"><%= p.nama_prioritas %></div>
                <div class="text-[10px] font-semibold text-slate-500"><%= p.jenis %></div>
            </div>
            <div class="flex gap-2 flex-shrink-0">
                <a href="/pengaturan?tab=prioritas&edit_prioritas_id=<%= p.id_prioritas %>"
                   class="bg-white hover:bg-gray-50 text-slate-700 text-[10px] font-bold py-1.5 px-3 rounded-lg border border-gray-200">Edit</a>
                <form action="/pengaturan/prioritas/hapus/<%= p.id_prioritas %>" method="POST"
                      onsubmit="return confirm('Hapus prioritas ini?')">
                    <button type="submit" class="bg-transparent hover:bg-red-50 text-red-600 border border-red-200 text-[10px] font-bold py-1.5 px-3 rounded-lg">Hapus</button>
                </form>
            </div>
        </div>
        <% }); %>
        <% if (prioritas.length === 0) { %>
            <div class="text-center text-slate-500 text-xs py-8 bg-white/60 rounded-xl border border-white/40">Belum ada prioritas.</div>
        <% } %>
    </div>

<% } %>

<!-- ══════════════ TAB KATEGORI ══════════════ -->
<% if (tabAktif === 'kategori') { %>

    <% if (editKategori) { %>
    <div data-reveal="scale" class="bg-white/90 rounded-2xl p-5 shadow-sm border border-white/40 mb-5">
        <h3 class="text-sm font-bold text-slate-800 mb-4">Edit Kategori: <%= editKategori.nama_kategori %></h3>
        <form action="/pengaturan/kategori/update/<%= editKategori.id_kategori %>" method="POST" class="space-y-3">
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">ID Kategori <span class="text-slate-400 font-normal">(tidak dapat diubah)</span></label>
                <input type="text" value="<%= editKategori.id_kategori %>" disabled
                       class="w-full bg-slate-100 border border-slate-200 rounded-lg px-3 py-2 text-xs font-semibold text-slate-500">
            </div>
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">Nama Kategori</label>
                <input type="text" name="input_nama_kategori_baru" value="<%= editKategori.nama_kategori %>" required
                       class="w-full bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-xs font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="flex gap-2 pt-2">
                <a href="/pengaturan?tab=kategori" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 text-xs font-bold py-2 rounded-lg text-center">Batal</a>
                <button type="submit" class="flex-1 bg-[#1e3a8a] hover:bg-blue-800 text-white text-xs font-bold py-2 rounded-lg shadow-md">Simpan</button>
            </div>
        </form>
    </div>
    <% } %>

    <div data-reveal="scale" class="bg-white/90 rounded-2xl p-5 shadow-sm border border-white/40 mb-5">
        <h3 class="text-sm font-bold text-slate-800 mb-4">Tambah Kategori Baru</h3>
        <form action="/pengaturan/kategori/tambah" method="POST" class="space-y-3">
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">Nama Kategori</label>
                <input type="text" name="input_nama_kategori_baru" placeholder="Misal: Makan Siang, Bensin, Gaji" required
                       class="w-full bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-xs font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-slate-700 mb-1">ID Kategori <span class="text-slate-400 font-normal">(opsional, auto jika kosong)</span></label>
                <input type="text" name="input_id_kategori_baru" placeholder="Misal: MAKAN, BENSIN" maxlength="30"
                       class="w-full bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-xs font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 uppercase">
            </div>
            <button type="submit" class="w-full bg-[#1c9c4b] hover:bg-emerald-700 text-white text-xs font-bold py-2 rounded-lg shadow-md">Tambah Kategori</button>
        </form>
    </div>

    <div class="space-y-2">
        <% kategori.forEach(function(k) { %>
        <div data-reveal class="bg-white/80 rounded-xl px-4 py-3 shadow-sm border border-white/40 flex items-center justify-between gap-3">
            <div class="min-w-0">
                <div class="text-sm font-bold text-slate-800 truncate"><%= k.nama_kategori %></div>
                <div class="text-[10px] font-mono font-semibold text-slate-400"><%= k.id_kategori %></div>
            </div>
            <div class="flex gap-2 flex-shrink-0">
                <a href="/pengaturan?tab=kategori&edit_kategori_id=<%= k.id_kategori %>"
                   class="bg-white hover:bg-gray-50 text-slate-700 text-[10px] font-bold py-1.5 px-3 rounded-lg border border-gray-200">Edit</a>
                <form action="/pengaturan/kategori/hapus/<%= k.id_kategori %>" method="POST"
                      onsubmit="return confirm('Hapus kategori ini?')">
                    <button type="submit" class="bg-transparent hover:bg-red-50 text-red-600 border border-red-200 text-[10px] font-bold py-1.5 px-3 rounded-lg">Hapus</button>
                </form>
            </div>
        </div>
        <% }); %>
        <% if (kategori.length === 0) { %>
            <div class="text-center text-slate-500 text-xs py-8 bg-white/60 rounded-xl border border-white/40">Belum ada kategori.</div>
        <% } %>
    </div>

<% } %>

<%- include('partials/mainFooter') %>