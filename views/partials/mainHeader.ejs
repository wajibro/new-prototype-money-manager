<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ditemoney - Money Manager</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gradient-to-br from-[#4fa9f9] via-[#85c4ff] to-white min-h-screen flex justify-center p-0 sm:p-4">

    <div class="w-full max-w-md bg-transparent flex flex-col min-h-screen sm:min-h-[90vh] py-6 px-4">
        
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-900 tracking-tight">Ditemoney</h2>
            <a href="/auth/logout" class="bg-[#3b82f6]/80 hover:bg-blue-600 text-white text-xs font-semibold px-4 py-1.5 rounded-lg shadow-sm transition-colors duration-200 uppercase tracking-wider">
                Logout
            </a>
        </div>

        <div class="bg-white/60 backdrop-blur-md rounded-2xl p-6 shadow-md relative mb-6 text-slate-800">
            <div class="text-sm font-medium opacity-90 mb-1">Saldo saat ini</div>
            <div class="flex items-center gap-3 mb-6">
                <span class="text-3xl font-bold tracking-tight text-slate-900"><%= totalSaldo %></span>
            </div>

            <div class="flex gap-10">
                <div>
                    <div class="text-emerald-700 font-semibold text-sm flex items-center gap-1 mb-0.5">
                        <span class="text-base font-bold">↓</span> Pemasukan
                    </div>
                    <div class="text-emerald-700 font-bold"><%= totalPemasukan %></div>
                </div>
                
                <div>
                    <div class="text-red-700 font-semibold text-sm flex items-center gap-1 mb-0.5">
                        <span class="text-base font-bold">↑</span> Pengeluaran
                    </div>
                    <div class="text-red-700 font-bold"><%= totalPengeluaran %></div>
                </div>
            </div>
        </div>
        <% if (message) { %>
            <div class="alert"><%= message %></div>
        <% } %>